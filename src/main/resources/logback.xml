<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The latest lines, for the Logs page in Settings -->
    <appender name="RECENT" class="organizer.RecentLogs"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="RECENT"/>
    </root>
    <logger name="io.netty" level="WARN"/>
</configuration>
